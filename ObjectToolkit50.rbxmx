          <ProtectedString name="Source">-- Object Toolkit 50 | 38 Collectible coin
-- MIT | timura032 | Setup: README / INSTALL_RU_EN.txt
local Players = game:GetService("Players")
local function actor(player, origin, range)
    local character = player and player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health &lt;= 0 or not root then return end
    if origin and (root.Position - origin.Position).Magnitude &gt; range then return end
    return character, humanoid, root
end
local function touchedPlayer(hit, origin)
    local model = hit:FindFirstAncestorOfClass("Model")
    local player = model and Players:GetPlayerFromCharacter(model)
    if player and actor(player, origin, origin.Size.Magnitude / 2 + 8) then return player end
end
local function reference(parent, name, class)
    local value = parent:FindFirstChild(name)
    local target = value and value:IsA("ObjectValue") and value.Value
    assert(target and target:IsA(class), "Add ObjectValue '" .. name .. "' pointing to " .. class)
    return target
end
local function prompt(parent, action)
    local p = Instance.new("ProximityPrompt")
    p.Name = "ToolkitPrompt"
    p.ActionText = action
    p.ObjectText = parent.Name
    p.MaxActivationDistance = 10
    p.HoldDuration = 0.15
    p.Parent = parent
    return p
end
local function onUse(p, origin, callback)
    p.Triggered:Connect(function(player)
        if p.Enabled and actor(player, origin, p.MaxActivationDistance + 2) then callback(player) end
    end)
end
local part = script.Parent
assert(part:IsA("BasePart"), "Put this Script inside a BasePart")
local busy = false
local transparency = part.Transparency
part.CanCollide = false
part.Touched:Connect(function(hit)
    local player = touchedPlayer(hit, part)
    if busy or not player then return end
    busy = true
    local board = player:FindFirstChild("leaderstats")
    if not board then board = Instance.new("Folder"); board.Name = "leaderstats"; board.Parent = player end
    local coins = board:FindFirstChild("ObjectCoins")
    if coins and not coins:IsA("IntValue") then busy = false; warn("ObjectCoins must be IntValue"); return end
    if not coins then coins = Instance.new("IntValue"); coins.Name = "ObjectCoins"; coins.Parent = board end
    coins.Value = coins.Value + 1
    part.Transparency = 1
    task.wait(10)
    if part.Parent then part.Transparency = transparency end
    busy = false
end)
