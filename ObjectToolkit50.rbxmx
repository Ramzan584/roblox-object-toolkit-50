local part = script.Parent
assert(part:IsA("BasePart"), "Put this Script inside a BasePart")
local UP_SPEED = 85
local cooldown = setmetatable({}, {__mode = "k"})
part.Touched:Connect(function(hit)
    local player = touchedPlayer(hit, part)
    if not player or (cooldown[player] or 0) &gt; os.clock() then return end
    local _, _, root = actor(player, part, part.Size.Magnitude / 2 + 8)
    if not root then return end
    cooldown[player] = os.clock() + 0.8
    local v = root.AssemblyLinearVelocity
    root.AssemblyLinearVelocity = Vector3.new(v.X, UP_SPEED, v.Z)
end)
